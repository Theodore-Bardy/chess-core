@startuml database

title Database Layer (Phase 4 complete)

note as Dep
  Dependency: SQLiteCpp 3.3.1 (MIT)
  Added via CMake FetchContent
end note

class Database {
    - db : SQLite::Database
    + Database(path : string)
    + importPGN(filePath : string) : int
    + searchGames(GameFilter const&) : vector<GameRecord>
    + getGame(id : int) : GameRecord
    + getGamesByPosition(fen : string) : vector<GameRecord>
    + saveAnalysis(gameId : int, moveNum : int, evalScore : float) : void
    + getPlayerStats(name : string) : PlayerStats
    -- private --
    - initSchema() : void
    - upsertPlayer(name : string) : int
    - recordToMeta(GameRecord const&) : GameMetadata
}

struct GameFilter {
    + white : string
    + black : string
    + result : string
    + dateFrom : string
    + dateTo : string
    + eco : string
    + minElo : int
    + maxElo : int
    + GameFilter()
}

struct GameRecord {
    + id : int
    + pgnText : string
    + result : string
    + date : string
    + white : string
    + black : string
    + whiteElo : int
    + blackElo : int
    + eco : string
    + opening : string
    + event : string
    + site : string
    + round : string
    + GameRecord()
}

struct PlayerStats {
    + name : string
    + gamesPlayed : int
    + wins : int
    + draws : int
    + losses : int
    + PlayerStats()
}

class Parser {
}

class Game {
}

class GameMetadata {
}

Database ..> GameFilter   : query input
Database ..> GameRecord   : query output
Database ..> PlayerStats  : query output
Database ..> Parser       : uses for importPGN / exportPGN
Database ..> Game         : loads game tree via Parser
Database ..> GameMetadata : converts to/from GameRecord

note right of Database
  SQLite schema (3 tables):

  players:
    id INTEGER PK AUTOINCREMENT
    name TEXT UNIQUE

  games:
    id INTEGER PK AUTOINCREMENT
    pgn_text TEXT
    result TEXT
    date TEXT
    white_player_id → players(id)
    black_player_id → players(id)
    white_elo INTEGER
    black_elo INTEGER
    eco TEXT, opening TEXT
    event TEXT, site TEXT, round TEXT

  positions:
    id INTEGER PK AUTOINCREMENT
    fen TEXT (indexed)
    game_id → games(id) ON DELETE CASCADE
    move_num INTEGER
    eval_score REAL (nullable, filled by Phase 5)

  Import flow:
    PGN file → Parser.loadGame() → Game tree
    → walk main line for FEN snapshots
    → INSERT into games + positions

  Export flow:
    getGame(id) → GameRecord → GameMetadata
    → new Game → Parser.saveGame()
end note

@enduml
